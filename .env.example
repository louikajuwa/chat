# Admin panel login password. Empty disables admin login.
ADMIN_PASSWORD=change-me
# Cookie signing secret: openssl rand -hex 32
SESSION_SECRET=generate-with-openssl-rand-hex-32
# MySQL root password (db + db-setup only; the app never sees it): openssl rand -hex 24
MYSQL_ROOT_PASSWORD=generate-with-openssl-rand-hex-24
# Password of the least-privilege `chat_app` MySQL user used by the app: openssl rand -hex 24
DB_APP_PASSWORD=generate-with-openssl-rand-hex-24
# Production only (docker-compose.prod.yml): public hostname for Caddy / Let's Encrypt.
# SITE_ADDRESS=chat.example.com
